# Copy this file to p5-deployment/.env and fill in your own credentials.
# The Streamlit app loads that file automatically; exported variables take priority.

# ---- LLM (one set) ----
# Any OpenAI-compatible Chat Completions endpoint (institute API, Groq, LM Studio, ...).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: CA certificate for a private HTTPS endpoint (Docker: /app/p5-deployment/certs/...).
LLM_CA_CERT=
# Optional: set false if the server does not support response_format JSON mode.
LLM_JSON_MODE=true

# ---- Embeddings (one set) ----
IITK_EMBED_URL=
IITK_EMBED_KEY=
CACERT_PATH=
# Use absolute certificate paths locally; Docker uses /app/p5-deployment/certs/.

# Langfuse: create API keys in your project's settings.
# Tracing starts when all three credentials/URL settings are configured.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Set this to your Langfuse project's regional or self-hosted URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_ENVIRONMENT=development

# Chat messages allowed per rolling window, per Streamlit session.
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW_SECONDS=60

# Exact response cache (preview replies are never cached).
CHAT_CACHE_ENABLED=true
CHAT_CACHE_TTL_SECONDS=3600
# Agent keys are fingerprinted from actual P2 settings, prompt files, P4 code and P3 files.
CHAT_BACKEND=agent
# Cumulative input + output allowance across research steps and JSON repairs.
AGENT_TOKEN_BUDGET=24000

# Model-call cache is separate from the final-answer cache above.
LLM_CACHE=1
LLM_LOG_PATH=p5-deployment/data/logs/llm_calls.jsonl
LLM_CACHE_PATH=p5-deployment/data/llm_cache.sqlite
LLM_LOCK_PATH=p5-deployment/data/llm_api.lock

# Retrieval defaults to p4-agent/p3_retrieval in the supplied P4 package.
# Optional override: P3_RAG_PATH=/absolute/path/to/p4-agent/p3_retrieval
# Optional approved P2 package; defaults to p4-agent/integration/p2_agents.
# P2_PACKAGE_PATH=/absolute/path/to/p2_agents

# Optional: override the SQLite history path. Use an absolute path.
# Default: p5-deployment/data/chat_history.sqlite3 beside app.py.
# CHAT_HISTORY_DB=/absolute/path/to/chat_history.sqlite3

# Optional for local Streamlit runs; Compose sets redis://redis:6379/0 itself.
# Start Redis with: docker compose -f p5-deployment/docker-compose.yml up -d redis
# REDIS_URL=redis://localhost:6379/0

# Optional local reranker (~1.11 GB download on first use).
RAG_RERANKER_ENABLED=false

# Optional Docker build: install local query embedding/reranking models.
# Run: docker compose --env-file p5-deployment/.env up --build -d
# INSTALL_LOCAL_MODELS=true
